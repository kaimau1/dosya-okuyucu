#!/bin/sh
# usta saglik kiti (refs/kit.md): kirmizi testle push edilmez.
# --no-verify ile gecme; testi kok nedeninden duzelt.
# Ayni agac (commit icerigi) tool/test_gate.sh ile zaten yesil test edildiyse
# tekrar kosulmaz; degilse kapi burada kosar.
ROOT=$(git rev-parse --show-toplevel) || exit 1
STAMP="$ROOT/.git/test-green"
need=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # dal silme: test gerekmez
  tree=$(git rev-parse "$local_sha^{tree}")
  [ -f "$STAMP" ] || { need=1; continue; }
  green=$(cat "$STAMP")
  [ "$green" = "$tree" ] && continue
  # Yesil agactan fark yalniz testi etkilemeyen yollardaysa (CI'in da atladigi) yeniden kosulmaz.
  if git diff --name-only "$green" "$tree" 2>/dev/null       | grep -qvE '^(\.github/|docs/|graphify-out/|hooks/)|\.md$'; then
    need=1
  elif ! git cat-file -e "$green" 2>/dev/null; then
    need=1
  fi
done
if [ "$need" = 0 ]; then
  echo "pre-push: bu agac zaten yesil test edildi (.git/test-green) - push devam."
  exit 0
fi
if ! sh "$ROOT/tool/test_gate.sh"; then
  echo ""
  echo "PUSH ENGELLENDI: testler kirmizi (usta refs/kit.md)."
  exit 1
fi
echo "pre-push: testler yesil, push devam."
