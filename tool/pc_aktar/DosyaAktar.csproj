<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8: her Windows 10/11'de kurulu gelir, exe tek dosya ve kurulumsuz çalışır. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DosyaAktar</AssemblyName>
    <RootNamespace>DosyaAktar</RootNamespace>
    <ApplicationIcon />
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Dosya Aktar</Product>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Security" />
    <Reference Include="System.Numerics" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.2" />
    <!-- Linux/macOS dotnet SDK ile derlemek icin; Windows derlemesinde etkisiz. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
