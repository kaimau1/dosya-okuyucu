<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Gemini AI / Firebase için internet. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- ── Arka planda indirme ─────────────────────────────────────────────
         Kullanıcı isteği (2026-07-29): "arka planda mutlaka devam etmeli".
         İndirme, uygulama kapansa da sürsün diye Android'de ÖN PLAN
         SERVİSİNDE koşar; bu da kalıcı bir ilerleme bildirimi gerektirir.
         POST_NOTIFICATIONS yalnız Android 13+ içindir ve verilmezse indirme
         yine çalışır — sadece bildirim görünmez. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- ── Dosya yöneticisi izinleri ───────────────────────────────────────
         Android 11+ (API 30): bir dosya yöneticisinin tüm depolamayı
         gezebilmesi için MANAGE_EXTERNAL_STORAGE gerekir; klasik READ izni
         yalnız medyaya yeter, SAF ise her klasörü tek tek seçtirir.
         Android ≤12 için klasik READ/WRITE (maxSdkVersion ile sınırlı),
         Android 13+ için bölünmüş medya izinleri yedek yol olarak durur
         (kullanıcı "tüm dosyalar"ı vermezse en azından medya görünür). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <!-- APK dosyasına dokununca kurulum ekranını açabilmek için. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- Belge tarayıcı (kamera). Tarayıcı eklentisi kendi manifest'inde kamerayı
         ZORUNLU özellik (required="true") olarak bildiriyor; öyle kalırsa Play
         Store uygulamayı kamerasız cihazlarda (bazı tabletler, Chromebook)
         GİZLER. Dosya okuyucu kamerasız da tam çalıştığı için zorunluluk
         kaldırılıyor — tarama, kamerası olan cihazlarda çalışır. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera"
        android:required="false"
        tools:replace="android:required"/>

    <!-- "Uygulamalar" ekranı: yüklü uygulamaların SON AÇILMA tarihi.
         Bu ÖZEL bir izindir (normal izin penceresi yok): kullanıcı
         Ayarlar > Kullanım erişimi'nden elle verir; verilmezse liste yine
         gelir, yalnız son açılma bilinmez. QUERY_ALL_PACKAGES /
         REQUEST_DELETE_PACKAGES izinlerini installed_apps eklentisi kendi
         manifest'inde bildiriyor (birleştirme ile gelir). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>

    <application
        android:label="Dosya Okuyucu"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"/>

            <!-- Uygulama başlatıcı -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- "Birlikte aç": başka uygulamalardan gelen dosyaları görüntüle
                 (WhatsApp/Gmail/Dosyalar → Dosya Okuyucu).
                 MIME listesi SADECE gerçekten açabildiğimiz biçimler olmalı;
                 `*/*` yazılırsa .apk/.zip/video gibi işimiz olmayan her dosyada
                 uygulama "birlikte aç" listesinde çıkar. Yeni biçim desteği
                 eklenirse (FileService.kindForExtension) buraya da eklenmeli. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel.sheet.macroEnabled.12" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <!-- 2026-07-25: video/ses artık uygulama içinde oynatılıyor
                     (video_player/ExoPlayer) → "birlikte aç" listesinde
                     çıkmamız anlamlı. `*/*` hâlâ YOK (apk kirliliği). -->
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <!-- **ARŞİVLER** (kullanıcı 2026-08-17: *"zip rar açarken
                     seçenekler arasında yokuz"*). Bir .zip'e dokununca
                     "Şununla aç" listesinde RAR, Google Files ve Dosya
                     Yöneticisi vardı ama biz yoktuk — oysa uygulamanın kendi
                     arşiv görüntüleyicisi var (`ArchiveScreen` + `ArchiveOps`;
                     zip/rar/7z/tar/gz açar, `EntryOpener` arşivi oraya
                     yönlendirir).

                     Kök neden: zip/rar desenleri YALNIZ aşağıdaki http/https
                     "indirme bağlantısı" süzgecindeydi; yerel bir dosyayı açan
                     `content:`/`file:` süzgecinde hiçbir arşiv MIME türü yoktu.

                     Aynı tür için birden çok ad dolaşıyor (Android sürümüne ve
                     dosyayı veren uygulamaya göre değişir) — hepsi yazılmalı,
                     yoksa bazı cihazlarda yine listede çıkmayız. -->
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="multipart/x-zip" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/x-rar" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
                <data android:mimeType="application/x-bzip2" />
                <data android:mimeType="application/java-archive" />
            </intent-filter>

            <!-- **İNDİRME BAĞLANTISINA DOKUNULUNCA SEÇENEK OLARAK ÇIKMAK.**
                 Chrome/DuckDuckGo'da doğrudan bir dosya bağlantısına
                 dokunulduğunda Android "hangi uygulamayla?" diye sorar; bu
                 filtre olmadan listede görünmüyorduk (kullanıcı isteği
                 2026-07-29: "indirme kısmında seçenek olarak çıkmalıyız").

                 **pathPattern ŞART:** yalnız `http`/`https` yazıp desen
                 koymazsak HER bağlantıda (haber sitesi, arama sonucu…)
                 tarayıcı yerine biz öneriliriz — kullanıcıyı çileden çıkarır.
                 Bu yüzden yalnız indirilebilir dosya uzantıları listelenir.
                 Android'de pathPattern tam yolu eşler ve `\\.` kaçışı ister;
                 sorgu dizeli adresler (…apk?token=…) için ayrıca `.*` ekli
                 ikinci desen yazılır. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
                <!-- Aşağıdaki adlar eşleşme için GEREKSİZ (`*` zaten hepsini
                     tutuyor); ayarlar ekranı için var. Android 12'den beri
                     doğrulanmamış web filtreleri seçicide gizleniyor ve tek
                     çare kullanıcının "Varsayılan olarak aç → Desteklenen
                     bağlantıları aç" ekranından elle izin vermesi. O ekran
                     manifestteki alan adlarını LİSTELER; yalnız `*` yazılıysa
                     bazı cihazlarda liste boş çıkıyor ve kullanıcının
                     işaretleyebileceği hiçbir şey olmuyor. En sık kullanılan
                     adlar tek tek yazılınca liste dolu geliyor. -->
                <data android:host="github.com" />
                <data android:host="objects.githubusercontent.com" />
                <data android:host="raw.githubusercontent.com" />
                <data android:host="codeload.github.com" />
                <data android:pathPattern=".*\\.apk" />
                <data android:pathPattern=".*\\.apk.*" />
                <data android:pathPattern=".*\\.zip" />
                <data android:pathPattern=".*\\.zip.*" />
                <data android:pathPattern=".*\\.rar" />
                <data android:pathPattern=".*\\.7z" />
                <data android:pathPattern=".*\\.tar" />
                <data android:pathPattern=".*\\.gz" />
                <data android:pathPattern=".*\\.pdf" />
                <data android:pathPattern=".*\\.pdf.*" />
                <data android:pathPattern=".*\\.docx" />
                <data android:pathPattern=".*\\.xlsx" />
                <data android:pathPattern=".*\\.pptx" />
                <data android:pathPattern=".*\\.mp4" />
                <data android:pathPattern=".*\\.mkv" />
                <data android:pathPattern=".*\\.mp3" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\.iso" />
            </intent-filter>

            <!-- Bazı sunucular/tarayıcılar uzantı yerine MIME bildirir
                 (örn. `…/download?id=42` + application/vnd.android.package-archive).
                 Bu filtre o durumları yakalar; yine yalnız indirilebilir
                 türlerle sınırlı. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:mimeType="application/vnd.android.package-archive" />
                <data android:scheme="https" android:mimeType="application/vnd.android.package-archive" />
                <data android:scheme="http" android:mimeType="application/zip" />
                <data android:scheme="https" android:mimeType="application/zip" />
                <data android:scheme="http" android:mimeType="application/octet-stream" />
                <data android:scheme="https" android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Tarayıcıdan paylaşılan BAĞLANTI: Chrome/DuckDuckGo'da bir
                 bağlantıya uzun basıp "Paylaş → Dosya Okuyucu" denince adres
                 buraya text/plain olarak gelir ve indirme akışı açılır
                 (kullanıcı isteği 2026-07-29). Dosya MIME'lerinden AYRI bir
                 filtre: text/plain'i aşağıdaki listeye eklemek, düz metin
                 dosyalarının paylaşımıyla karışırdı. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Paylaş menüsünden tek/çoklu dosya (aynı MIME listesi). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel.sheet.macroEnabled.12" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <!-- 2026-07-25: video/ses artık uygulama içinde oynatılıyor
                     (video_player/ExoPlayer) → "birlikte aç" listesinde
                     çıkmamız anlamlı. `*/*` hâlâ YOK (apk kirliliği). -->
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <!-- **ARŞİVLER** (kullanıcı 2026-08-17: *"zip rar açarken
                     seçenekler arasında yokuz"*). Bir .zip'e dokununca
                     "Şununla aç" listesinde RAR, Google Files ve Dosya
                     Yöneticisi vardı ama biz yoktuk — oysa uygulamanın kendi
                     arşiv görüntüleyicisi var (`ArchiveScreen` + `ArchiveOps`;
                     zip/rar/7z/tar/gz açar, `EntryOpener` arşivi oraya
                     yönlendirir).

                     Kök neden: zip/rar desenleri YALNIZ aşağıdaki http/https
                     "indirme bağlantısı" süzgecindeydi; yerel bir dosyayı açan
                     `content:`/`file:` süzgecinde hiçbir arşiv MIME türü yoktu.

                     Aynı tür için birden çok ad dolaşıyor (Android sürümüne ve
                     dosyayı veren uygulamaya göre değişir) — hepsi yazılmalı,
                     yoksa bazı cihazlarda yine listede çıkmayız. -->
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="multipart/x-zip" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/x-rar" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
                <data android:mimeType="application/x-bzip2" />
                <data android:mimeType="application/java-archive" />
            </intent-filter>
        </activity>

        <!-- ── SEÇİCİ KİPİ: çekmecedeki "uygulamada aç" OKU ────────────────
             Kullanıcı bulgusu 2026-08-10 (ikinci ekran görüntüsü): *"biz
             çıkıyoruz ama bizim arayüzümüze yönlendiren işaret çıkmıyor."*
             Kök satırı (aşağıdaki provider) seçicinin KENDİ arayüzünde
             gezdirir; yanında ok olan satırlar ise `ACTION_GET_CONTENT`
             karşılayan uygulamalardır ve dokununca o uygulamanın kendi ekranı
             açılır. Bu aktivite o satırı sağlar.

             **AYRI aktivite ŞART:** MainActivity `singleTask` ve Android'de
             singleTask bir aktivite sonuç döndüremez (çağıran anında
             RESULT_CANCELED alır). Filtreyi oraya koymak, listede görünüp
             hiçbir zaman dosya veremeyen bir satır üretirdi.

             `excludeFromRecents`: seçici kipi çağıran uygulamanın görevinin
             parçasıdır; son kullanılanlarda ayrı bir "Dosya Okuyucu" kartı
             bırakmak kullanıcıyı yarım kalmış bir ekrana geri döndürürdü. -->
        <activity
            android:name=".PickerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.OPENABLE"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>

        <!-- ── BELGE SAĞLAYICI: "Şuradan aç" listesinde görünmek ───────────
             Kullanıcı bulgusu 2026-08-10 (ekran görüntüsüyle): *"bu listede
             bizim adımız yok"* — Android'in dosya seçicisindeki soldan açılan
             kaynak çekmecesi (Son / İndirilenler / Dosya Yöneticisi / Drive…)
             YALNIZCA `DocumentsProvider` bildiren uygulamaları listeler.
             Yukarıdaki VIEW/SEND filtreleri "Birlikte aç" ve "Paylaş"
             menüleri içindir, o çekmece için yetmez.

             `android:permission="android.permission.MANAGE_DOCUMENTS"` sistemin
             belge seçicisinden BAŞKA hiçbir uygulamanın sağlayıcıyı doğrudan
             sorgulayamamasını sağlar (bu izin yalnız sistemde vardır); seçici
             de seçilen dosya için çağırana geçici URI izni verir. Bu, Android
             belgelendirmesindeki standart kalıptır — izinsiz `exported="true"`
             bir sağlayıcı tüm depolamayı her uygulamaya açardı. -->
        <provider
            android:name=".DosyaProvider"
            android:authorities="com.dosyaokuyucu.dosya_okuyucu.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER"/>
            </intent-filter>
        </provider>

        <!-- ── İş kuyruğunun ÖN PLAN SERVİSİ ───────────────────────────────
             Kullanıcı hatası 2026-07-30: "arka plana alınca uygulamayı
             duraklıyor işlem". Android, ön planda olmayan süreci (özellikle
             MIUI gibi agresif pil yönetimlerinde) donduruyor; video kodlama
             native iş parçacığında koşsa bile süreç askıya alınınca duruyor.
             Ön plan servisi süreci "kullanıcının gördüğü iş" sınıfına sokar.

             Servisi flutter_local_notifications sağlıyor (startForegroundService)
             — ayrı bir paket gerekmedi ve servisin bildirimi zaten bizim
             ilerleme bildirimimiz. Eklenti servisi KENDİ manifest'inde
             bildirmiyor, uygulamanın bildirmesi şart.

             stopWithTask="true" DÜRÜSTLÜK GEREĞİ: iş uygulamanın Dart
             izolatında koşuyor; görev listesinden kapatılınca izolat ölür,
             ayakta kalan servis yalnız donmuş bir bildirim gösterirdi. -->
        <service
            android:name="com.dexterous.flutterlocalnotifications.ForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            android:stopWithTask="true" />

        <!-- Flutter v2 gömme (embedding) işareti. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Metin işleme (PROCESS_TEXT) görünürlüğü — Flutter varsayılanı. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ paket görünürlüğü: "başka uygulamayla aç" (open_filex)
             hedef uygulamayı ancak bu sorgu varsa bulabilir; yoksa video/ses/
             apk dosyalarında "uygulama yok" hatası alınır. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="*/*"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE"/>
        </intent>
    </queries>
</manifest>
