<?xml version="1.0" encoding="utf-8"?>
<!-- Son dosyalar widget'ı (bkz. ci/Extras.kt RecentWidget). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/w_bg">
    <TextView
        android:id="@+id/r_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/w_ink"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"/>
    <TextView
        android:id="@+id/r_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/w_ink_soft"
        android:textSize="12sp"/>
    <TextView
        android:id="@+id/r_1"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/w_pill"
        android:drawableStart="@drawable/ic_w_file"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/w_ink"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="middle"/>
    <TextView
        android:id="@+id/r_2"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/w_pill"
        android:drawableStart="@drawable/ic_w_file"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/w_ink"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="middle"/>
    <TextView
        android:id="@+id/r_3"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/w_pill"
        android:drawableStart="@drawable/ic_w_file"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/w_ink"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="middle"/>
    <TextView
        android:id="@+id/r_4"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/w_pill"
        android:drawableStart="@drawable/ic_w_file"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/w_ink"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="middle"/>
</LinearLayout>
