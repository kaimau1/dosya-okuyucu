<?xml version="1.0" encoding="utf-8"?>
<!-- Depolama + hızlı eylemler widget'ı (bkz. ci/Extras.kt StorageWidget). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/w_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/w_ink_soft"
                android:textSize="12sp"
                android:maxLines="1"/>
            <TextView
                android:id="@+id/w_free"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/w_ink"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"/>
        </LinearLayout>
        <TextView
            android:id="@+id/w_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/w_ink_soft"
            android:textSize="12sp"
            android:maxLines="1"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/w_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progressDrawable="@drawable/w_bar"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/w_scan"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/w_pill"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_w_scan"/>
            <TextView
                android:id="@+id/w_scan_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/w_ink"
                android:textSize="13sp"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_search"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/w_pill"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_w_search"/>
            <TextView
                android:id="@+id/w_search_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/w_ink"
                android:textSize="13sp"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_clean"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/w_pill"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_w_clean"/>
            <TextView
                android:id="@+id/w_clean_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/w_ink"
                android:textSize="13sp"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
