<?xml version="1.0" encoding="utf-8"?>
<!-- G1.1 (B3): bulut yedeği ve cihazdan cihaza aktarımda uygulama verisi (ayarlar,
     kasa, sunucu kayıtları) dışarı çıkmaz. Ayarlar uygulamanın kendi "Ayar yedeği"yle taşınır. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="sharedpref"/>
        <exclude domain="database"/>
        <exclude domain="file"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="sharedpref"/>
        <exclude domain="database"/>
        <exclude domain="file"/>
    </device-transfer>
</data-extraction-rules>
